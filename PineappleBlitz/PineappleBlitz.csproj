<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PineappleBlitz</RootNamespace>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.1.0</Version>
    <Configuration>Release</Configuration>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <!-- Path to the SPT server binaries. Override on the command line if your install lives elsewhere:
       dotnet build -p:SptServerDir="D:\SPT\SPT_Runtime" -->
  <PropertyGroup>
    <SptServerDir Condition="'$(SptServerDir)' == ''">F:\SPT 4.1\SPT_Runtime</SptServerDir>
    <ModDeployDir Condition="'$(ModDeployDir)' == ''">$(SptServerDir)\user\mods\PineappleBlitz-LumurkFox</ModDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Common">
      <HintPath>$(SptServerDir)\SPTarkov.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.DI">
      <HintPath>$(SptServerDir)\SPTarkov.DI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SPTarkov.Server.Core">
      <HintPath>$(SptServerDir)\SPTarkov.Server.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SemanticVersioning">
      <HintPath>$(SptServerDir)\SemanticVersioning.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="config\config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy the built mod straight into the server's mod folder. Skip with -p:DeployToServer=false -->
  <Target Name="DeployToSptServer" AfterTargets="Build"
          Condition="'$(DeployToServer)' != 'false' And Exists('$(SptServerDir)')">
    <MakeDir Directories="$(ModDeployDir)\config" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDir)" />
    <Copy SourceFiles="config\config.json" DestinationFolder="$(ModDeployDir)\config" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed PineappleBlitz to $(ModDeployDir)" />
  </Target>
</Project>
